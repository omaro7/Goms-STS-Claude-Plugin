<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension point="org.eclipse.ui.views">
        <category id="kr.co.goms.sts.claude.category" name="Goms AI Tools"/>
        <view id="kr.co.goms.sts.claude.ui.ClaudeChatView"
              name="Claude Code Chat"
              category="kr.co.goms.sts.claude.category"
              class="kr.co.goms.sts.claude.ui.ClaudeChatView"
              icon="icons/claude_chat.png"
              restorable="true"/>
    </extension>

    <!-- V1.3: Maven compile errors / failed tests in the Problems view (not persisted across restarts) -->
    <extension id="buildProblem" name="Goms Maven Problem" point="org.eclipse.core.resources.markers">
        <super type="org.eclipse.core.resources.problemmarker"/>
        <super type="org.eclipse.core.resources.textmarker"/>
        <persistent value="false"/>
    </extension>

    <!-- V1.1: Ask Claude about the current editor selection -->
    <extension point="org.eclipse.ui.commands">
        <category id="kr.co.goms.sts.claude.commands" name="Goms AI Tools"/>
        <command id="kr.co.goms.sts.claude.askAboutSelection"
                 categoryId="kr.co.goms.sts.claude.commands"
                 name="Ask Claude about Selection"
                 description="Open Claude Code Chat with the current file and selection attached as context"/>
    </extension>
    <extension point="org.eclipse.ui.handlers">
        <handler commandId="kr.co.goms.sts.claude.askAboutSelection"
                 class="kr.co.goms.sts.claude.ui.AskClaudeHandler"/>
    </extension>
    <extension point="org.eclipse.ui.menus">
        <menuContribution locationURI="popup:#CompilationUnitEditorContext?after=additions">
            <command commandId="kr.co.goms.sts.claude.askAboutSelection" label="Ask Claude about Selection" icon="icons/claude_chat.png" style="push"/>
        </menuContribution>
        <menuContribution locationURI="popup:#TextEditorContext?after=additions">
            <command commandId="kr.co.goms.sts.claude.askAboutSelection" label="Ask Claude about Selection" icon="icons/claude_chat.png" style="push"/>
        </menuContribution>
    </extension>
    <extension point="org.eclipse.ui.bindings">
        <key commandId="kr.co.goms.sts.claude.askAboutSelection"
             contextId="org.eclipse.ui.textEditorScope"
             schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
             sequence="M1+M3+K"/>
    </extension>
</plugin>
